# ── OpenTicket F0 — copia este archivo a .env y completa. Ver README.md paso a paso. ──

# Postgres (Supabase → Project Settings → Database → Connection string URI,
# o Postgres local). NUNCA commitear la real.
DATABASE_URL=postgres://postgres:password@localhost:5432/openticket

# Stripe TEST MODE (dashboard.stripe.com → modo test → Developers → API keys).
# Solo claves sk_test_ — el código se niega a arrancar con claves live.
STRIPE_SECRET_KEY=sk_test_xxx

# Secret del webhook. Local: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# imprime un whsec_... — pegarlo acá.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend (resend.com → API Keys). Si se deja vacío, los emails se imprimen
# en consola (fallback de desarrollo, no bloquea la demo).
RESEND_API_KEY=
# Remitente. Sin dominio verificado en Resend usar: OpenTicket <onboarding@resend.dev>
EMAIL_FROM=OpenTicket <onboarding@resend.dev>

# URL pública de la app (success/cancel del checkout y links del email)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Minutos de reserva de cupo. 30 = mínimo que permite Stripe Checkout expires_at.
RESERVATION_MINUTES=30

# Fee de plataforma en basis points (500 = 5%, take-rate plano según SYNTHESIS)
PLATFORM_FEE_BPS=500

# Secreto para firmar la cookie de sesion de organizadores (>=16 chars aleatorios)
AUTH_SECRET=
