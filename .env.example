# ── OpenTicket F0 — copy this file to .env and fill it in. See README.md step by step. ──

# Postgres (Supabase → Project Settings → Database → Connection string URI,
# or local Postgres). NEVER commit the real one.
DATABASE_URL=postgres://postgres:password@localhost:5432/openticket

# Stripe TEST MODE (dashboard.stripe.com → test mode → Developers → API keys).
# sk_test_ keys only — the code refuses to start with live keys.
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook secret. Local: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# prints a whsec_... — paste it here.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend (resend.com → API Keys). If left empty, emails are printed to the
# console (development fallback, does not block the demo).
RESEND_API_KEY=
# Sender. Without a verified domain in Resend use: OpenTicket <onboarding@resend.dev>
EMAIL_FROM=OpenTicket <onboarding@resend.dev>

# Public app URL (checkout success/cancel and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Inventory hold duration in minutes. 30 = the minimum Stripe Checkout expires_at allows.
RESERVATION_MINUTES=30

# Platform fee in basis points (500 = 5%, flat take rate per SYNTHESIS)
PLATFORM_FEE_BPS=500

# Secret used to sign the organizer session cookie (>=16 random chars)
AUTH_SECRET=
