# TEST environment — dummy/local values only. Tests abort if the Stripe key
# does not start with sk_test (guard in test/setup.ts).
# Integration: local Homebrew Postgres (brew services start postgresql@16
# && createdb openticket_test). No docker.
DATABASE_URL=postgres://lucas@localhost:5432/openticket_test
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_test_dummy
RESEND_API_KEY=
EMAIL_FROM=OpenTicket <test@example.com>
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESERVATION_MINUTES=30
PLATFORM_FEE_BPS=500
AUTH_SECRET=test-only-secret-abcdef123456
